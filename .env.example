# ---------------------------------------------------------------------------
# WeatherGPT frontend configuration
#
# Copy this file to `.env` and fill in the values you have.
#   cp .env.example .env
#
# Everything here is optional. The defaults work for local development,
# where the Vite dev server proxies `/api` to the FastAPI backend.
#
# NOTE: never put the Anthropic or OpenWeatherMap key here. Anything prefixed
# with VITE_ is bundled into the browser and is therefore public.
# ---------------------------------------------------------------------------

# Base URL for the backend API. Leave empty (or unset) to use the relative
# "/api" path, which the Vite dev server proxies to the FastAPI backend.
#
# The value MUST include the "/api" prefix, because the app calls endpoints
# like "/weather/current" relative to this base.
#
#   VITE_API_BASE_URL=http://127.0.0.1:3001/api
VITE_API_BASE_URL=

# Where the Vite dev server forwards `/api` requests.
VITE_BACKEND_URL=http://127.0.0.1:3001
